; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Resource",
"class": "AudioInfo",
"language": "GDScript",
"path": "res://resource/audio_info.gd"
}, {
"base": "Control",
"class": "GameDeliveryItem",
"language": "GDScript",
"path": "res://src/game_item.gd"
}, {
"base": "Resource",
"class": "LevelData",
"language": "GDScript",
"path": "res://resource/level_data.gd"
}, {
"base": "Resource",
"class": "LevelItems",
"language": "GDScript",
"path": "res://resource/level_items.gd"
} ]
_global_script_class_icons={
"AudioInfo": "",
"GameDeliveryItem": "",
"LevelData": "",
"LevelItems": ""
}

[application]

config/name="task4"
run/main_scene="res://src/game_manager.tscn"
config/icon="res://icon.png"

[autoload]

Globals="*res://src/globals.gd"
AudioManager="*res://src/audio_manager.gd"

[display]

window/stretch/mode="viewport"
window/stretch/aspect="expand"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input]

up={
"deadzone": 0.5,
"events": [ Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"alt":false,"shift":false,"control":false,"meta":false,"command":false,"pressed":false,"scancode":0,"physical_scancode":87,"unicode":0,"echo":false,"script":null)
 ]
}
